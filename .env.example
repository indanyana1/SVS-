REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_STRIPE_PUBLIC_KEY=
REACT_APP_STRIPE_CURRENCY=zar
STRIPE_SECRET_KEY=
SERVER_PORT=5000

# Error/crash monitoring (https://sentry.io — free tier is enough to start).
# Both unset by default: the app runs identically either way, it just won't
# report crashes anywhere until these are filled in. Create one Sentry
# project and use its DSN for both — REACT_APP_SENTRY_DSN is the browser
# side (src/lib/errorMonitoring.js), SENTRY_DSN (no REACT_APP_ prefix, so it
# never gets bundled into client JS) is the server side (server.js,
# api/stripe-webhook.js) via server-utils/errorMonitoring.js.
REACT_APP_SENTRY_DSN=
SENTRY_DSN=

# EmailJS (https://www.emailjs.com) — used to send password-reset links
# and wallet one-time codes straight from the browser, no backend needed.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
# Optional: a separate template for wallet OTP emails (worded for a
# 6-digit code instead of a reset link). Falls back to
# REACT_APP_EMAILJS_TEMPLATE_ID above when unset.
REACT_APP_EMAILJS_OTP_TEMPLATE_ID=
# Optional: a separate template for general notification emails (booking
# confirmed/rescheduled/declined, order placed/status updates, seller
# application reviewed, new chat messages). Falls back to
# REACT_APP_EMAILJS_TEMPLATE_ID above when unset. Recommended template
# variables: {{notification_title}}, {{notification_message}},
# {{action_url}} — plus the same {{to_email}}/{{to_name}} aliases used by
# the other templates. Without a dedicated template, the title/message get
# passed into the password-reset template's variables too (see
# src/lib/notificationEmail.js) so it still renders something readable.
REACT_APP_EMAILJS_NOTIFICATION_TEMPLATE_ID=

